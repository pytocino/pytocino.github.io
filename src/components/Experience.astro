---
import { getContent, type Locale } from "../content/index.ts";
import Chips from "./Chips.astro";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { experience, sectionIds } = getContent(locale);
---

<section class="section" id={sectionIds.experiencia}>
  <div class="container">
    <SectionHeader kicker={experience.kicker} title={experience.title} />
    <ol class="timeline">
      {
        experience.jobs.map((job) => (
          <li class="job">
            <div class="job__meta">
              <span class="job__period mono">{job.period}</span>
              <span class="job__place">{job.place}</span>
            </div>
            <div class="job__body">
              <h3>{job.role}</h3>
              <p class="job__company">{job.company}</p>
              <p class="job__summary">{job.summary}</p>
              {job.groups.length > 0 && (
                <div class="job__groups">
                  {job.groups.map((g) => (
                    <details>
                      <summary>{g.title}</summary>
                      <ul>
                        {g.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </details>
                  ))}
                </div>
              )}
              <Chips items={job.tech} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline { list-style: none; display: grid; gap: clamp(40px, 6vw, 64px); }
  .job { display: grid; gap: 12px; padding-left: 20px; border-left: 2px solid var(--accent); }
  .job__meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; color: var(--muted); }
  .job__period { color: var(--ink); }
  h3 { font-size: clamp(28px, 3.6vw, 40px); }
  .job__company { font-weight: 600; margin-top: 6px; }
  .job__summary { color: var(--ink-soft); margin-top: 10px; max-width: 62ch; }
  .job__groups { margin: 20px 0; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 14px 0; cursor: pointer; list-style: none; font-weight: 500;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--font-mono); font-size: 18px; color: var(--accent); transition: transform .2s; }
  details[open] summary::after { content: "−"; }
  summary:hover { color: var(--accent); }
  details ul { display: grid; gap: 10px; padding: 0 0 18px 18px; color: var(--ink-soft); font-size: 15px; max-width: 70ch; }
  details li::marker { color: var(--accent); }
  .job__body > :global(.chips) { margin-top: 18px; }

  @media (min-width: 900px) {
    .job { grid-template-columns: 200px 1fr; gap: 40px; padding-left: 28px; }
    .job__meta { flex-direction: column; padding-top: 10px; }
  }
</style>
