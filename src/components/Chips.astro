---
interface Props {
  items: string[];
  label?: string;
}

const { items, label } = Astro.props;
---

<ul class="chips" aria-label={label}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  li {
    font-family: var(--font-mono); font-size: 12px; line-height: 1;
    padding: 7px 10px; border-radius: 8px;
    background: var(--card); border: 1px solid var(--line); color: var(--ink-soft);
  }
</style>
