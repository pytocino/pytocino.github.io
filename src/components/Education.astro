---
import { getContent, type Locale } from "../content/index.ts";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { education, sectionIds } = getContent(locale);
---

<section class="section" id={sectionIds.formacion}>
  <div class="container">
    <SectionHeader kicker={education.kicker} title={education.title} />
    <ul class="edu">
      {
        education.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .edu { list-style: none; border-top: 1px solid var(--ink); }
  li { display: grid; gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  h3 { font-size: clamp(24px, 2.8vw, 32px); }
  p { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  @media (min-width: 900px) {
    li { grid-template-columns: 1fr 360px; align-items: baseline; gap: 40px; }
    p { text-align: right; }
  }
</style>
