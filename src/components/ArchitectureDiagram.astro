---
import type { SiteContent } from "../content/types.ts";

interface Props {
  title: string;
  arch: SiteContent["project"]["arch"];
}

const { title, arch } = Astro.props;
// "API Laravel 13 · Laravel Cloud · colas" → ["API Laravel 13", "Laravel Cloud · colas"]
const lines = (label: string): [string, string] => {
  const [first = "", ...rest] = label.split(" · ");
  return [first, rest.join(" · ")];
};

type Node = { x: number; y: number; w: number; h: number; label: [string, string]; strong?: boolean };
const nodes: Node[] = [
  { x: 20, y: 20, w: 174, h: 64, label: lines(arch.app), strong: true },
  { x: 202, y: 20, w: 148, h: 64, label: lines(arch.web) },
  { x: 20, y: 134, w: 330, h: 64, label: lines(arch.api), strong: true },
  { x: 20, y: 248, w: 92, h: 64, label: lines(arch.data) },
  { x: 120, y: 248, w: 122, h: 64, label: lines(arch.storage) },
  { x: 250, y: 248, w: 100, h: 64, label: lines(arch.push) },
];
const desc = `${arch.app} + ${arch.web} → ${arch.api} → ${arch.data}, ${arch.storage}, ${arch.push}`;
---

<svg class="arch" viewBox="10 10 350 312" role="img" aria-labelledby="arch-title arch-desc">
  <title id="arch-title">{title}</title>
  <desc id="arch-desc">{desc}</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" fill="#e6ac33"></path>
    </marker>
  </defs>

  <g fill="none" stroke="#e6ac33" stroke-width="1.5" marker-end="url(#arrow)">
    <path d="M107 84 V130"></path>
    <path d="M276 84 V130"></path>
    <path d="M66 198 V244"></path>
    <path d="M181 198 V244"></path>
    <path d="M300 198 V244"></path>
  </g>

  {
    nodes.map((n) => (
      <g class:list={["node", { "node--strong": n.strong }]}>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12"></rect>
        {n.label[1] ? (
          <>
            <text x={n.x + n.w / 2} y={n.y + n.h / 2 - 4} text-anchor="middle" class="t1">{n.label[0]}</text>
            <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 15} text-anchor="middle" class="t2">{n.label[1]}</text>
          </>
        ) : (
          <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 5} text-anchor="middle" class="t1">{n.label[0]}</text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .arch { width: 100%; max-width: 440px; margin-inline: auto; }
  rect { fill: rgb(255 255 255 / 0.04); stroke: rgb(243 233 216 / 0.28); stroke-width: 1; }
  .node--strong rect { fill: rgb(230 172 51 / 0.1); stroke: #e6ac33; }
  text { fill: #f3e9d8; font-family: var(--font-mono); }
  .t1 { font-size: 14px; font-weight: 600; }
  .t2 { font-size: 13px; opacity: 0.75; }
</style>
