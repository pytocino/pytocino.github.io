---
interface Props {
  kicker: string;
  title: string;
}

const { kicker, title } = Astro.props;
---

<header class="section-header">
  <span class="kicker">{kicker}</span>
  <h2>{title}</h2>
</header>

<style>
  .section-header { margin-bottom: clamp(28px, 4vw, 48px); }
  h2 { font-size: clamp(38px, 6vw, 64px); }
</style>
